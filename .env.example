# Looped marketing site: environment.
#
# Copy to .env.local for a local run, or set these in the production host's
# environment. Nothing here has a secret value committed; the placeholders show
# the shape only.
#
# The site is deliberately safe when unconfigured: without a store the waitlist
# refuses signups rather than dropping them, without a PostHog key nothing is
# tracked, and without NEXT_PUBLIC_ALLOW_INDEXING nothing is indexable.

# ── Site identity ────────────────────────────────────────────────────────────

# The public origin, with no trailing slash. Drives metadataBase, every
# canonical URL, the sitemap and robots.txt. REQUIRED in production: the
# fallback is http://localhost:3000, which is obviously wrong if it ships.
NEXT_PUBLIC_SITE_URL=https://your-production-domain

# 🔴 INDEXING IS OFF UNLESS THIS IS EXACTLY "true".
# Set it ONLY on the real production domain. Any other value, or absent, and
# robots.txt disallows everything and every page carries a noindex tag, so a
# review or staging deployment cannot be indexed by accident.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── Waitlist persistence (choose ONE) ────────────────────────────────────────

# Production: a Supabase project with the waitlist_signups table applied from
# supabase/migrations/. The service-role key is a server-only secret. It must
# never be given a NEXT_PUBLIC_ prefix and never reaches the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional: defaults to waitlist_signups.
SUPABASE_WAITLIST_TABLE=waitlist_signups

# Review host only: an absolute path to an append-only JSON-lines file. Opt-in
# and never a default, because on a serverless host a file write looks like it
# worked and then disappears with the instance.
# WAITLIST_FILE_STORE=/var/lib/looped-site/waitlist.jsonl

# ── Founder notification (optional; failure never fails a signup) ────────────

# A Slack incoming webhook, or any endpoint that takes a JSON POST. With
# neither set, a stored signup logs a line saying no notifier is configured.
WAITLIST_NOTIFY_SLACK_WEBHOOK=
WAITLIST_NOTIFY_WEBHOOK_URL=

# ── Analytics (optional) ─────────────────────────────────────────────────────

# A PostHog project key. With no key, no event is sent, no identifier is
# written and no request is made. Host defaults to https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Optional hero ────────────────────────────────────────────────────────────

# Public Spline scene URL (uses the Spline hero instead of Three.js when set).
# Example: https://prod.spline.design/xxxxxxxxxxxxxxxx/scene.splinecode
NEXT_PUBLIC_SPLINE_SCENE_URL=
